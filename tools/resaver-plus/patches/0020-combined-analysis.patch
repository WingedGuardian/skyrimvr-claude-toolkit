+		struct Layout { std::size_t members = 0; bool complete = true; };
+		class Layouts
+		{
+			const Papyrus& p;
+			std::unordered_map<TStr, Layout> cache;
+		public:
+			explicit Layouts(const Papyrus& value) : p(value) {}
+			Layout get(TStr name)
+			{
+				std::vector<const Script*> chain;
+				std::unordered_set<TStr> seen;
+				Layout result;
+				for (;;) {
+					if (auto it = cache.find(name); it != cache.end()) { result = it->second; break; }
+					const auto* node = p.findScript(name);
+					if (!node || !seen.insert(name).second) { result.complete = false; break; }
+					chain.push_back(node);
+					if (p.str(node->parent).empty()) break;
+					name = node->parent;
+				}
+				for (auto it = chain.rbegin(); it != chain.rend(); ++it) {
+					if (result.complete) result.members += (*it)->members.size();
+					cache[(*it)->name] = result;
+				}
+				return result;
+			}
+		};
