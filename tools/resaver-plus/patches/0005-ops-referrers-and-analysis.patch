+		// Resolve counts once per saved script, without recursion or an arbitrary depth
+		// cutoff. Unknown parents/cycles make the layout unavailable, not mismatched.
+		struct Layout { std::size_t members = 0; bool complete = true; };
+		class Layouts
+		{
+			const Papyrus& p;
+			std::unordered_map<TStr, Layout> cache;
+		public:
+			explicit Layouts(const Papyrus& value) : p(value) {}
+			Layout get(TStr name)
+			{
+				std::vector<const Script*> chain;
+				std::unordered_set<TStr> seen;
+				Layout result;
+				for (;;) {
+					if (auto it = cache.find(name); it != cache.end()) { result = it->second; break; }
+					const auto* node = p.findScript(name);
+					if (!node || !seen.insert(name).second) { result.complete = false; break; }
+					chain.push_back(node);
+					if (p.str(node->parent).empty()) break;
+					name = node->parent;
+				}
+				for (auto it = chain.rbegin(); it != chain.rend(); ++it) {
+					if (result.complete) result.members += (*it)->members.size();
+					cache[(*it)->name] = result;
+				}
+				return result;
+			}
+		};
+		void AnalyzeMemberData(const Papyrus& p, Report& r)
+		{
+			Layouts layouts(p);
+			Evidence definitions, parents, parentless, unresolved, missing, empty, mismatch, references;
+			for (const auto& sc : p.scripts) {
+				const auto sample = "script:" + p.str(sc.name);
+				if (IsScriptUndefined(p, sc)) definitions.add(sample);
+				if (IsMissingParent(p, sc)) parents.add(sample);
+				if (IsNoParent(p, sc)) parentless.add(sample);
+				if (!layouts.get(sc.name).complete) unresolved.add(sample);
+			}
+			auto relationship = [&](TStr name, const std::string& sample) {
+				if (!p.findScript(name) && !IsNativeScriptName(p.str(name)) && !IsEngineType(p.str(name))) missing.add(sample + " script:" + p.str(name));
+			};
+			for (const auto& i : p.instances) {
+				const auto sample = Identity("instance", i.id);
+				relationship(i.script, sample);
+				const auto layout = layouts.get(i.script);
+				if (!layout.complete) continue;
+				const auto values = i.data ? i.data->vars.size() : 0;
+				if (!values && layout.members) empty.add(sample);
+				else if (values && values != layout.members) mismatch.add(sample);
+			}
+			for (const auto& ref : p.references) {
+				const auto sample = Identity("reference", ref.id);
+				relationship(ref.script, sample);
+				if (IsInstanceUndefined(p, ref.script)) references.add(sample);
+			}
+			// A global/native call frame need not own a saved script definition.
+			// Preserve IsThreadUndefined semantics instead of inventing a dependency.
+			auto emit = [&](const char* code, const Evidence& e, const char* explanation) {
+				if (e.count) FindingFor(r, code, std::to_string(e.count) + " " + explanation, e.count, e.samples);
+			};
+			emit("papyrus.undefined-definitions", definitions, "non-native saved script definitions have no parent; review before changing mods.");
+			emit("papyrus.missing-parents", parents, "saved script definitions have an empty or absent parent definition.");
+			emit("papyrus.parentless-definitions", parentless, "non-native saved script definitions have no parent.");
+			emit("papyrus.unresolved-member-layout", unresolved, "script member layouts cannot be resolved because of missing ancestors or an inheritance cycle; member-count comparison is unavailable.");
+			emit("papyrus.missing-script-definitions", missing, "saved instance/reference relationships name an absent script definition; this does not establish whether a mod is installed.");
+			emit("papyrus.undefined-references", references, "saved references use undefined script definitions.");
+			emit("papyrus.member-data-missing", empty, "script instances have no saved member values although their resolved definitions declare members.");
+			emit("papyrus.member-data-mismatch", mismatch, "script instances have a different number of saved values and resolved declared members; review script-version changes.");
+		}
 	}
 
