# User-specific settings (contains local paths)
.claude/settings.local.json
.claude/housekeep.json

# Backups (generated at runtime)
.claude/backups/
# What the guard pruned from its own stores, waiting for housekeep's session sweep to send it to the Recycle Bin
.claude/retired/

# Node modules
node_modules/

# OS files
Thumbs.db
Desktop.ini
.DS_Store

# Nexus personal API key -- NEVER commit
tools/.nexus_api_key
.nexus_api_key
*.nexus_api_key

# Python virtualenv + test caches (dev only)
.venv/
.skyguard/
__pycache__/
.pytest_cache/

# Machine-local paths recorded by setup.sh for the safety hooks. Never tracked:
# it names one user's directories, and shipping it would point another
# install's guard at a folder that does not exist there. 4.0 writes it at the
# toolkit root; the .claude/ spelling is the 3.x location, still read as a fallback.
/skyrim-paths.env
.claude/skyrim-paths.env

# YOUR knowledgebase, not ours. Never tracked and never shipped: the update path is
# "extract the new zip over your install", so any file the toolkit ships is replaced.
# A file that is both shipped by us and appended to by you loses your work on update.
KNOWLEDGEBASE.local.md

# The pose-emulating null driver is FETCHED on the user's machine (pinned, hash-verified) and never shipped:
# delivery decision and licence: tools/vr-emu-driver/README.md. work/ is a pre-4.0 build cache, still ignored.
tools/vr-emu-driver/build/
tools/vr-emu-driver/work/
# ReSaver Plus is BUILT on the user's machine from pinned upstream source plus the shipped patches; nothing binary
# ships (tools/resaver-plus/README.md). `backend` is the user's own backend choice.
tools/resaver-plus/build/
tools/resaver-plus/work/
tools/resaver-plus/backend
.modding-agent-harness/
tools/resaver-cli/.compiled/
