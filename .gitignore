# User-specific settings (contains local paths)
.claude/settings.local.json

# Backups (generated at runtime)
.claude/backups/

# Node modules
node_modules/

# OS files
Thumbs.db
Desktop.ini
.DS_Store

# Nexus personal API key -- NEVER commit
tools/.nexus_api_key
.nexus_api_key
*.nexus_api_key

# Python virtualenv + test caches (dev only)
.venv/
__pycache__/
.pytest_cache/

# Machine-local paths recorded by setup.sh for the safety hooks. Never tracked:
# it names one user's directories, and shipping it would point another
# install's guard at a folder that does not exist there. 4.0 writes it at the
# toolkit root; the .claude/ spelling is the 3.x location, still read as a fallback.
/skyrim-paths.env
.claude/skyrim-paths.env

# YOUR knowledgebase, not ours. Never tracked and never shipped: the update path is
# "extract the new zip over your install", so any file the toolkit ships is replaced.
# A file that is both shipped by us and appended to by you loses your work on update.
KNOWLEDGEBASE.local.md
