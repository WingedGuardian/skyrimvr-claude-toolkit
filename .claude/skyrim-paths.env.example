# Example only. setup.sh writes the real skyrim-paths.env at the toolkit root (the
# folder it is run in); you should not need to create it by hand. A 3.x install's
# .claude/skyrim-paths.env is still read when the root file is absent.
#
# protect-bash.sh derives your install root from its own location, so these are
# ADDITIVE. They let it also guard the config and load-order directories, which live
# outside the install and cannot be derived.
SKYRIM_GAME_ROOT="C:/GOG Games/The Elder Scrolls V Skyrim VR"
SKYRIM_CONFIG_DIR="C:/Users/YOU/Documents/My Games/Skyrim VR"
SKYRIM_LOADORDER_DIR="C:/Users/YOU/AppData/Local/Skyrim VR"
# Mod Organizer 2 only (empty otherwise): every mod's real files live here, outside
# the install, so the guard protects them only when told where they are.
SKYRIM_MO2_MODS=""
SKYRIM_MO2_OVERWRITE=""
# The Python setup.sh resolved for the guards (empty = not recorded). Not a root.
SKYGUARD_PYTHON=""
#
# The guard reads this file as DATA, not by sourcing it. A value it cannot read
# exactly as bash would (an unescaped $ or backtick inside double quotes, an
# unquoted space, a relative path) is refused with "GUARD INERT" naming the key,
# never skipped. Single quotes are the safest spelling; setup.sh writes them.
