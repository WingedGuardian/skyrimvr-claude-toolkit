# Example only. setup.sh writes the real .claude/skyrim-paths.env from the folder it
# is run in; you should not need to create it by hand.
#
# protect-bash.sh derives your install root from its own location, so these are
# ADDITIVE. They let it also guard the config and load-order directories, which live
# outside the install and cannot be derived.
SKYRIM_GAME_ROOT="C:/GOG Games/The Elder Scrolls V Skyrim VR"
SKYRIM_CONFIG_DIR="C:/Users/YOU/Documents/My Games/Skyrim VR"
SKYRIM_LOADORDER_DIR="C:/Users/YOU/AppData/Local/Skyrim VR"
